<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.claude.slack-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/ayushpuri/claude-auto/slack-bot.py</string>
  </array>
  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/ayushpuri</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:/Users/ayushpuri/.local/bin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ayushpuri/claude-auto/logs/slack_bot_launchd_stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ayushpuri/claude-auto/logs/slack_bot_launchd_stderr.log</string>
</dict>
</plist>
